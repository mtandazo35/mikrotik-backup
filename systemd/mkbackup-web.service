[Unit]
Description=Panel web de mkbackup
After=network.target

[Service]
Type=simple

# Corre como root porque todo vive bajo /root (ver el mismo comentario en
# mkbackup.service). Aqui pesa mas que en el programador: esto es lo unico del
# sistema que escucha en un puerto, o sea la unica superficie que se puede
# atacar desde fuera. Dejalo en 127.0.0.1 (web.direccion) y ponle delante un
# proxy con TLS si hace falta verlo desde otra maquina.
User=root
Group=root
# El codigo vive en app/ y los datos en la carpeta de arriba. Separados a
# proposito: con el repositorio y los respaldos mezclados, un `git clean`
# de alguien depurando se lleva los backups por delante.
WorkingDirectory=/root/mkbackup/app
ExecStart=/root/mkbackup/.venv/bin/python -m mkbackup.cli -c /root/mkbackup/config.yaml --web

NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
# ProtectHome=true dejaria /root inaccesible, y ahi vive todo.
ProtectHome=false

# El panel ya NO es de solo lectura: da de alta equipos, asi que necesita
# escribir el inventario, y guarda los ajustes que se cambian desde la web, las
# cuentas, el registro de auditoria y la imagen de fondo del login.
#
# Y hay que decirlo entero, porque esta linea ya no acota lo que parece: con el
# permiso 'datos.mudanza', una cuenta del panel puede SUBIR un .tar.gz y
# reemplazar con el TODO lo que hay en esta carpeta -el historico completo, el
# inventario, las cuentas y hasta el propio config.yaml, que es una de las
# piezas del paquete-. O sea que esto no es "escribe algunos archivos suyos":
# es "puede sustituir el servidor entero por otro". Lo que queda fuera del
# alcance del panel es solo lo que este FUERA de esta ruta.
#
# Que config.yaml viva aqui dentro es lo que hace que la mudanza funcione en
# una maquina nueva, y a la vez lo que hace que ese permiso pese tanto: se da
# a quien administra el servidor, no a quien mira la flota.
ReadWritePaths=/root/mkbackup

ProtectKernelTunables=true
ProtectKernelModules=true
ProtectControlGroups=true
RestrictSUIDSGID=true
RestrictRealtime=true
LockPersonality=true

# Necesita salir a la red para preguntarle su nombre a un router al darlo de
# alta (/system identity). Antes no hablaba con ningun equipo y esto estaba
# mas cerrado; el alta con nombre automatico es lo que lo cambio.
RestrictAddressFamilies=AF_INET AF_INET6

# Es un servicio de consulta: que su caida no arrastre nada, pero que vuelva.
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
