__pycache__/
*.py[cod]
.venv/
venv/
*.egg-info/

# Configuracion real y datos generados. La barra inicial limita el patron a la
# raiz: sin ella tambien se ignorarian examples/inventory.csv y similares.
/config.yaml
/inventory.csv
/datos/
/respaldos/
*.log

# Estado del simulador de pruebas
tests/.dns_simulado

# Cosas propias del despliegue que no son del proyecto: la imagen de fondo del
# login, notas, pruebas. El panel la sirve desde donde diga web.fondo_login,
# asi que no tiene por que vivir en el repositorio.
/local/

# Ajustes de Claude Code. El compartido (.claude/settings.json) SI se sube: es
# una lista corta de comandos de solo lectura que evita tener que aprobar la
# bateria de pruebas una por una. El .local NO: son cientos de permisos de un
# solo uso que se acumulan al ir dando a "permitir", pesa 70 KB y no le sirve a
# nadie mas.
/.claude/settings.local.json
/.claude/*.tmp.*
